# Copiar a .env para producción y cargar estas variables en el servidor.
# Node no carga .env automáticamente sin --env-file (Node >= 20); en desarrollo hay credenciales demo.
PORT=3001
ADMIN_USER=admin
ADMIN_PASSWORD=CAMBIAR_CONTRASENA
SESSION_SECRET=REEMPLAZAR_POR_SECRETO_ALEATORIO_DE_32_CARACTERES_MINIMO
NODE_ENV=production
# En Render con disco persistente montado en /var/data:
DATA_PATH=/var/data/store.json
IMAGE_CACHE_DIR=/var/data/images
